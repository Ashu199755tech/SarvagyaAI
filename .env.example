# ── Employee Data API ────────────────────────────────────
EMPLOYEE_API_BASE_URL=http://localhost:8000

# ── Ollama (local LLM) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── ChromaDB ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ── MS Teams Bot ─────────────────────────────────────────
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# ── Ingestion Schedule ───────────────────────────────────
INGESTION_INTERVAL_HOURS=6

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
